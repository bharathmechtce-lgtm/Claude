# -----------------------------------------------
# Shared / Global
# -----------------------------------------------
ANTHROPIC_API_KEY=<your-anthropic-key>
WEBHOOK_VERIFY_TOKEN=tjuk-bot-verify-2024

# Optional — set to "true" to skip actual WhatsApp sending (logs only)
DRY_RUN=false

# LLM model (default: claude-sonnet-4-5-20250929)
# LLM_MODEL=claude-sonnet-4-5-20250929

# -----------------------------------------------
# Client: TJUK
# -----------------------------------------------
TJUK_WHATSAPP_TOKEN=<tjuk-access-token>
TJUK_WHATSAPP_PHONE_NUMBER_ID=<tjuk-phone-number-id>
# Optional — for HMAC signature validation
TJUK_WHATSAPP_APP_SECRET=<tjuk-app-secret>

# -----------------------------------------------
# Client: ACS
# -----------------------------------------------
ACS_WHATSAPP_TOKEN=<acs-access-token>
ACS_WHATSAPP_PHONE_NUMBER_ID=<acs-phone-number-id>
# Optional
ACS_WHATSAPP_APP_SECRET=<acs-app-secret>

# -----------------------------------------------
# Legacy single-tenant (still supported as fallback)
# -----------------------------------------------
# WHATSAPP_TOKEN=<your-token>
# WHATSAPP_PHONE_NUMBER_ID=<your-phone-number-id>
# WHATSAPP_APP_SECRET=<your-app-secret>
